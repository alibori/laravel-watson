{
    "name": "alibori/laravel-watson",
    "description": "Laravel Watson watches your application's exceptions, uses the Laravel AI SDK to diagnose the likely cause and fix, and notifies you only when it's actually worth knowing about.",
    "keywords": [
        "Axel Libori Roch",
        "laravel",
        "laravel-watson"
    ],
    "homepage": "https://github.com/alibori/laravel-watson",
    "license": "MIT",
    "authors": [
        {
            "name": "Axel Libori Roch",
            "email": "a.libori@gmal.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/ai": "^1.3.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Alibori\\LaravelWatson\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alibori\\LaravelWatson\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "test:format": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alibori\\LaravelWatson\\LaravelWatsonServiceProvider"
            ],
            "aliases": {
                "LaravelWatson": "Alibori\\LaravelWatson\\Facades\\LaravelWatson"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
